# Never put this key in any invitation's browser or repository.
RESEND_API_KEY=
# Optional default sender. Must belong to a domain verified in Resend.
RESEND_FROM=notifications@estasinvitado.lat
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=
# Docker / Coolify: mount a persistent volume at /data.
# For npm start outside Docker, use ./.local/notifications.sqlite instead.
DATABASE_PATH=/data/notifications.sqlite
PORT=28461
